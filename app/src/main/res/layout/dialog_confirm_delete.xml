<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_neo_card"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="22dp"
    android:paddingBottom="22dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="@string/delete_confirm_title"
        android:textColor="@color/ink_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDeleteMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingMultiplier="1.25"
        android:textColor="@color/ink_primary"
        android:textSize="14sp"
        tools:text="Hapus APK hasil clone Dualapps 2 (com.dualapps.cloner.clone)?" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelDelete"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_neo_button_white"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:text="@string/action_cancel"
            android:textColor="@color/ink_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnConfirmDelete"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_neo_button_yellow"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:text="@string/action_delete"
            android:textColor="@color/ink_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
