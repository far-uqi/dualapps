<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fillViewport="true"
    tools:context=".ui.ConfigureCloneActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Bar atas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_neo_icon_button"
                android:contentDescription="@string/cd_back"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/title_configure_clone"
                android:textColor="@color/ink_muted"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Headline terkunci Bagian 2B -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.03"
            android:text="@string/headline_configure"
            android:textColor="@color/ink_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- Kartu folder aplikasi sumber (tab ungu mencuat di sisi atas kartu) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSourceTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="-2.5dp"
                android:background="@drawable/bg_neo_folder_tab_purple"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="@string/tab_source_app"
                android:textColor="@color/ink_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neo_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_neo_icon_tile_purple"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/ivSourceIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSourceName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/ink_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="Dualapps" />

                    <TextView
                        android:id="@+id/tvSourcePackage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/ink_muted"
                        android:textSize="12sp"
                        tools:text="com.dualapps.cloner" />

                    <TextView
                        android:id="@+id/tvSourceSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="8,4 MB" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Daftar berkas split (muncul hanya untuk aplikasi Split APK) -->
        <LinearLayout
            android:id="@+id/cardSplitFiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_neo_card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvSplitFilesHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/ink_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Daftar Berkas Split (3 file • 3,5 MB)" />

            <TextView
                android:id="@+id/tvSplitFilesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.25"
                android:textColor="@color/ink_muted"
                android:textSize="12sp"
                tools:text="• base.apk (1,8 MB)\n• config.arm64_v8a (1,6 MB)\n• config.xxhdpi (103 KB)" />
        </LinearLayout>

        <!-- Kolom Nama Clone -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/label_clone_name"
            android:textColor="@color/ink_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCloneName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_neo_card"
            android:hint="@string/hint_clone_name"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="4dp"
            android:textColor="@color/ink_primary"
            android:textColorHint="@color/ink_muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/note_clone_name_mvp"
            android:textColor="@color/ink_muted"
            android:textSize="12sp" />

        <!-- Kolom Package Name Clone -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/label_clone_package"
            android:textColor="@color/ink_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etClonePackage"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_neo_card"
            android:fontFamily="monospace"
            android:hint="@string/hint_clone_package"
            android:inputType="textNoSuggestions|textVisiblePassword"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="4dp"
            android:textColor="@color/ink_primary"
            android:textColorHint="@color/ink_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvPackageValidation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/ink_primary"
            android:textSize="12sp"
            tools:text="Package name tersedia dan siap dipakai." />

        <!-- Bagian Ikon Clone (opsional) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/label_clone_icon"
            android:textColor="@color/ink_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_neo_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <!-- Pratinjau persegi hasil crop tengah -->
            <FrameLayout
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_neo_icon_tile_teal"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/ivCloneIconPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_clone_icon_preview"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCloneIconStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.2"
                    android:text="@string/note_clone_icon_default"
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnPickIcon"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_neo_button_white"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:paddingEnd="4dp"
                        android:paddingBottom="4dp"
                        android:text="@string/action_pick_icon"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnResetIcon"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_neo_button_white"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:paddingEnd="4dp"
                        android:paddingBottom="4dp"
                        android:text="@string/action_reset_icon"
                        android:textColor="@color/ink_primary"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Disclaimer permanen (Bagian 2 poin 5) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_neo_card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/disclaimer_title"
                android:textColor="@color/ink_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDisclaimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/disclaimer_permanent"
                android:textColor="@color/ink_primary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Tombol aksi utama CLONE (kuning #FFCF5C) -->
        <TextView
            android:id="@+id/btnStartClone"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_neo_button_yellow"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:text="@string/action_clone"
            android:textColor="@color/ink_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
