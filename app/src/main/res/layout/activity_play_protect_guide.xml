<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fillViewport="true"
    tools:context=".ui.PlayProtectGuideActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Bar atas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_neo_icon_button"
                android:contentDescription="@string/cd_back"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="@string/play_protect_guide_title"
                android:textColor="@color/ink_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Penjelasan singkat kenapa Play Protect mewaspadai hasil clone -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="-2.5dp"
                android:background="@drawable/bg_neo_folder_tab_purple"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="@string/play_protect_why_tab"
                android:textColor="@color/ink_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neo_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/play_protect_why_heading"
                    android:textColor="@color/ink_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.25"
                    android:text="@string/play_protect_why_body"
                    android:textColor="@color/ink_primary"
                    android:textSize="13.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Opsi A: Detail selengkapnya -> Tetap pasang -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="-2.5dp"
                android:background="@drawable/bg_neo_folder_tab_teal"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="@string/play_protect_opt_a_tab"
                android:textColor="@color/ink_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neo_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/play_protect_opt_a_heading"
                    android:textColor="@color/ink_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.25"
                    android:text="@string/play_protect_opt_a_body"
                    android:textColor="@color/ink_primary"
                    android:textSize="13.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Opsi B: Nonaktifkan sementara Play Protect + pengingat wajib & peringatan risiko -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="-2.5dp"
                android:background="@drawable/bg_neo_folder_tab_purple"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="@string/play_protect_opt_b_tab"
                android:textColor="@color/ink_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neo_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/play_protect_opt_b_heading"
                    android:textColor="@color/ink_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.25"
                    android:text="@string/play_protect_opt_b_body"
                    android:textColor="@color/ink_primary"
                    android:textSize="13.5sp" />

                <!-- Kotak peringatan risiko & pengingat wajib aktifkan lagi -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_neo_card_yellow"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/play_protect_warning_title"
                        android:textColor="@color/ink_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingMultiplier="1.25"
                        android:text="@string/play_protect_warning_body"
                        android:textColor="@color/ink_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Opsi C: Alternatif pasang dari PC lewat ADB -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="-2.5dp"
                android:background="@drawable/bg_neo_folder_tab_teal"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="@string/play_protect_opt_c_tab"
                android:textColor="@color/ink_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neo_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/play_protect_opt_c_heading"
                    android:textColor="@color/ink_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.25"
                    android:text="@string/play_protect_opt_c_body"
                    android:textColor="@color/ink_primary"
                    android:textSize="13.5sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_neo_badge_split"
                    android:fontFamily="monospace"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:text="@string/play_protect_adb_command"
                    android:textColor="@color/bg_canvas"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Catatan statis bahwa aplikasi tidak menonaktifkan Play Protect -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:lineSpacingMultiplier="1.25"
            android:text="@string/play_protect_footer_note"
            android:textColor="@color/ink_muted"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
