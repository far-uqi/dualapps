<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fillViewport="true"
    tools:context=".ui.CloneProgressActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Bar atas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_neo_icon_button"
                android:contentDescription="@string/cd_back"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/tvTargetSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="@color/ink_muted"
                android:textSize="12sp"
                tools:text="com.dualapps.cloner.clone" />
        </LinearLayout>

        <!-- Headline terkunci Bagian 2B -->
        <TextView
            android:id="@+id/tvHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.03"
            android:lineSpacingMultiplier="0.95"
            android:text="@string/headline_cloning"
            android:textColor="@color/ink_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- Progress bar & persentase -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_weight="1"
                android:max="6"
                android:progress="0"
                android:progressTint="@color/ink_primary" />

            <TextView
                android:id="@+id/tvProgressCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="monospace"
                android:textColor="@color/ink_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="0/7" />
        </LinearLayout>

        <!-- Progres per file (tampil saat memproses Split APK multi-file) -->
        <TextView
            android:id="@+id/tvFileProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/ink_muted"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="File 2/5 • split_config.xxhdpi.apk"
            tools:visibility="visible" />

        <!-- Kartu daftar langkah pipeline -->
        <LinearLayout
            android:id="@+id/containerSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_neo_card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp" />

        <!-- Kartu Peringatan Kompatibilitas (Aturan B / override, non-error, gaya visual berbeda dari cardError) -->
        <LinearLayout
            android:id="@+id/cardWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="-2.5dp"
                android:background="@drawable/bg_neo_button_yellow"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/badge_compatibility_warning"
                android:textColor="@color/ink_primary"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neo_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/tvWarningMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.2"
                    android:textColor="@color/ink_primary"
                    android:textSize="13sp"
                    tools:text="Peringatan: aplikasi ini memanggil provider lintas-aplikasi ber-permission signature." />
            </LinearLayout>
        </LinearLayout>

        <!-- Kartu Error (muncul saat gagal / dibatalkan) -->
        <LinearLayout
            android:id="@+id/cardError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_neo_card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvErrorCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neo_badge_split"
                android:fontFamily="monospace"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/bg_canvas"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="SIGN_VERIFY_FAILED" />

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/ink_primary"
                android:textSize="14sp"
                tools:text="Pesan error dalam Bahasa Indonesia." />
        </LinearLayout>

        <!-- Kartu Hasil Clone (tab teal mencuat di atas kartu, muncul HANYA setelah langkah 7 lolos) -->
        <LinearLayout
            android:id="@+id/cardSuccessFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="-2.5dp"
                android:background="@drawable/bg_neo_folder_tab_teal"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="@string/tab_clone_result"
                android:textColor="@color/ink_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neo_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <TextView
                    android:id="@+id/tvSuccessName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/ink_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Dualapps 2" />

                <TextView
                    android:id="@+id/tvSuccessPackage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/ink_muted"
                    android:textSize="12.5sp"
                    tools:text="com.dualapps.cloner.clone" />

                <TextView
                    android:id="@+id/tvSuccessSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/ink_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Ukuran APK: 8,5 MB" />
            </LinearLayout>
        </LinearLayout>

        <!-- Indikator progres pemasangan (non-blocking, tampil selama sesi pasang aktif) -->
        <LinearLayout
            android:id="@+id/cardInstallProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_neo_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ProgressBar
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/ink_primary" />

            <TextView
                android:id="@+id/tvInstallProgressText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="@string/status_installing"
                android:textColor="@color/ink_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tombol Aksi Bawah -->
        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_neo_button_white"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:text="@string/action_cancel"
            android:textColor="@color/ink_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnInstall"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_neo_button_yellow"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:text="@string/action_install"
            android:textColor="@color/ink_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnRetry"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_neo_button_yellow"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:text="@string/action_retry"
            android:textColor="@color/ink_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnOverrideClone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_neo_button_white"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:text="@string/action_override_incompatible"
            android:textColor="@color/ink_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
