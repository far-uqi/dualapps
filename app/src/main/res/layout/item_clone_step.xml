<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="7dp">

    <TextView
        android:id="@+id/tvStepBadge"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_neo_step_pending"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textColor="@color/ink_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="1" />

    <TextView
        android:id="@+id/tvStepLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/ink_primary"
        android:textSize="14sp"
        tools:text="Patch AndroidManifest.xml (AXML)" />

    <TextView
        android:id="@+id/tvStepStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="monospace"
        android:textColor="@color/ink_muted"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="OK" />

</LinearLayout>
