    <!-- Static Play Protect Guide -->
    <string name="play_protect_banner_title">Blocked by Play Protect while installing?</string>
    <string name="play_protect_banner_subtitle">Read the official guide for the steps you can choose yourself.</string>
    <string name="play_protect_guide_title">Play Protect Guide</string>
    <string name="play_protect_why_tab">WHY IT\'S BLOCKED</string>
    <string name="play_protect_why_heading">Why does Play Protect flag cloned apps?</string>
    <string name="play_protect_why_body">Cloned APKs come from outside Google Play Store and are re-signed with a unique signing key generated on this device. Because the digital signature differs from the original developer and is not registered on Play Store, Google Play Protect may naturally flag or block installation.</string>
    <string name="play_protect_opt_a_tab">OPTION A — IN THE DIALOG</string>
    <string name="play_protect_opt_a_heading">Tap "More details" → "Install anyway"</string>
    <string name="play_protect_opt_a_body">When the Google Play Protect warning dialog appears during installation, tap "More details", then choose "Install anyway" if available.</string>
    <string name="play_protect_opt_b_tab">OPTION B — TEMPORARILY PAUSE</string>
    <string name="play_protect_opt_b_heading">Temporarily pause in Google Play Store settings</string>
    <string name="play_protect_opt_b_body">If "Install anyway" does not appear in the dialog, you can do this manually:\n\n1. Open Google Play Store.\n2. Tap your profile picture at the top right.\n3. Select "Play Protect", then tap the Settings (gear) icon at the top right.\n4. Temporarily turn off "Scan apps with Play Protect".\n5. Return to Dualapps and install the cloned APK.\n6. TURN "Scan apps with Play Protect" BACK ON immediately after installation finishes.</string>
    <string name="play_protect_warning_title">IMPORTANT REMINDER &amp; RISK WARNING</string>
    <string name="play_protect_warning_body">Remember to re-enable "Scan apps with Play Protect" right after installing your clone! Leaving Play Protect off reduces device protection against harmful or unknown apps. The decision to temporarily disable it is entirely up to you.</string>
    <string name="play_protect_opt_c_tab">OPTION C — ADB ALTERNATIVE</string>
    <string name="play_protect_opt_c_heading">Install from a computer (PC) via ADB</string>
    <string name="play_protect_opt_c_body">As an alternative without changing Play Protect settings, tap SHARE to copy the cloned APK to your computer, enable USB Debugging in Developer Options, connect your device to your PC, and run:</string>
    <string name="play_protect_adb_command">adb install cloned_app.apk</string>
    <string name="play_protect_footer_note">Note: Dualapps never disables and cannot automatically disable Google Play Protect or Android\'s package verifier.</string>
