<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dualapps" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_canvas</item>
        <item name="android:colorBackground">@color/bg_canvas</item>
        <item name="android:statusBarColor">@color/bg_canvas</item>
        <item name="android:navigationBarColor">@color/bg_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/ink_primary</item>
        <item name="android:textColorSecondary">@color/ink_muted</item>
        <item name="colorAccent">@color/accent_yellow</item>
        <item name="colorPrimary">@color/ink_primary</item>
        <item name="colorPrimaryDark">@color/ink_primary</item>
    </style>

    <style name="Theme.Dualapps.Dialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>
</resources>
