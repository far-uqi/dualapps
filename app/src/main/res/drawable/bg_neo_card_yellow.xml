<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bayangan keras solid hitam geser 4dp ke kanan-bawah tanpa blur -->
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink_primary" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Permukaan kartu kuning flat + border hitam 2.5dp + radius 12dp -->
    <item
        android:bottom="4dp"
        android:right="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_yellow" />
            <stroke
                android:width="2.5dp"
                android:color="@color/ink_primary" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
